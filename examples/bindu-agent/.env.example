# ─── Model backend ────────────────────────────────────────────────────────
# Either an OpenRouter or an OpenAI key is required. Set LLM_PROVIDER
# explicitly, or let the agent auto-detect (OpenRouter wins if only its
# key is set).

# LLM_PROVIDER=openrouter

# --- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=sk-...                                          # pragma: allowlist secret
# OPENAI_MODEL=gpt-4o

# --- OpenRouter ------------------------------------------------------------
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...                                # pragma: allowlist secret
# Any OpenRouter slug — e.g. openai/gpt-4o, anthropic/claude-3.7-sonnet,
# google/gemini-2.5-pro
# OPENROUTER_MODEL=openai/gpt-4o

# ─── Bindu server ─────────────────────────────────────────────────────────
# The port the bindufied agent will listen on. Defaults to 3773 (Bindu's
# canonical A2A port).
# BINDU_PORT=3773

# ─── EU-Regulations-MCP server ────────────────────────────────────────────
# Optional: override the path to the built MCP server entrypoint
# (default: ../../dist/index.js relative to this example).
# EU_REGULATIONS_MCP_ENTRY=../../dist/index.js
# Optional: override the path to the SQLite corpus
# (default: data/regulations.db at the repository root).
# EU_COMPLIANCE_DB_PATH=/absolute/path/to/regulations.db
