{
  "name": "@ansvar/eu-regulations-mcp",
  "version": "2.0.0",
  "private": true,
  "mcpName": "eu.ansvar/eu-regulations-mcp",
  "description": "EU regulations corpus MCP (GDPR, NIS2, DORA, AI Act +60). Served by the @ansvar/mcp-base chassis (Docker FROM-image); this repo holds the corpus build/ingest pipeline plus 5 EU-local extension tools. Customer access via gateway.ansvar.eu.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && find . -name '*.tsbuildinfo' -not -path './node_modules/*' -delete",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:db": "tsx scripts/build-db.ts",
    "ingest": "tsx scripts/ingest-eurlex.ts",
    "check-updates": "tsx scripts/check-updates.ts",
    "auto-update": "tsx scripts/check-updates.ts --sync",
    "ingest:versions": "tsx scripts/ingest-version-history.ts",
    "ingest:versions:seed": "tsx scripts/ingest-version-history.ts --seed-baseline",
    "ingest:versions:dry-run": "tsx scripts/ingest-version-history.ts --dry-run",
    "ingest:with-browser": "tsx scripts/ingest-eurlex-browser.ts",
    "ingest:ai-act-guidance": "npm run build:db && tsx scripts/ingest-ai-act-prohibited-practices.ts && tsx scripts/ingest-ai-act-definition-guidelines.ts && tsx scripts/ingest-ai-act-gpai-cop.ts && tsx scripts/ingest-ai-act-gpai-scope.ts && tsx scripts/ingest-ai-act-training-data-template.ts && tsx scripts/seed-ai-act-guidance-placeholders.ts",
    "ingest:guidance-wave1": "tsx scripts/ingest-eu-guidance-wave1.ts && tsx scripts/seed-wave1-guidance-placeholders.ts",
    "reingest:all": "tsx scripts/bulk-reingest-all.ts",
    "migrate:postgres": "tsx scripts/migrate-to-postgres.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compliance",
    "gdpr",
    "nis2",
    "dora",
    "ai-act",
    "eu-regulations",
    "cybersecurity",
    "cyber-resilience-act",
    "european-union",
    "legal",
    "regulatory",
    "claude",
    "llm"
  ],
  "author": "Ansvar Systems <hello@ansvar.eu> (https://ansvar.eu)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansvar-Systems/EU_compliance_MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Ansvar-Systems/EU_compliance_MCP/issues"
  },
  "homepage": "https://ansvar.eu",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^12.6.2",
    "glob": "^13.0.0",
    "puppeteer": "^24.36.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "puppeteer",
      "sharp"
    ],
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "qs": ">=6.14.2",
      "basic-ftp": ">=5.2.0",
      "vite": ">=7.3.2",
      "rollup": ">=4.59.0",
      "smol-toml": ">=1.6.1",
      "tar": ">=7.5.11",
      "undici@7": ">=7.24.0",
      "picomatch@2": ">=2.3.2",
      "picomatch@4": ">=4.0.4",
      "minimatch@3": ">=3.1.4",
      "minimatch@10": ">=10.2.3"
    }
  },
  "dependencies": {
    "@ansvar/mcp-sqlite": "^1.0.5",
    "cheerio": "^1.2.0",
    "jsdom": "^27.4.0",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.13.2"
  }
}
